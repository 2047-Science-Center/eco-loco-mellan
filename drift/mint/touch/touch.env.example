# ─────────────────────────────────────────────────────────────────────────
#  touch.env — PER MASKIN. Kopiera till touch.env och fyll i din(a) panel(er).
#  Kör  ./find-touch.sh  först: den skriver ut exakt de rader du ska klistra in.
#  Denna fil innehåller INGA lösenord/hemligheter — bara USB-portar + skärmnamn.
# ─────────────────────────────────────────────────────────────────────────

# En rad per touchpanel:   <ID_PATH>=<SKÄRM>
#   ID_PATH = touchpanelens fysiska USB-port (håller över omstart, även för
#             två IDENTISKA paneler — det var hela poängen).
#   SKÄRM   = utgångsnamnet ur `xrandr --listmonitors`, t.ex. DP-1 / HDMI-1.
#
# EN skärm (Minnestest, typiskt):
#   TOUCH_PAIRS="
#   pci-0000:00:14.0-usb-0:3:1.0=HDMI-1
#   "
#
# TVÅ skärmar (Förhandlingen, X&Y-riggen):
#   TOUCH_PAIRS="
#   pci-0000:00:14.0-usb-0:3:1.0=DP-1
#   pci-0000:00:14.0-usb-0:1:1.0=DP-3
#   "
TOUCH_PAIRS="
KLISTRA_IN_FRÅN_find-touch.sh=DP-1
"

# Självläkande watcher: applicera om mappningen var N:e sekund, så touchen
# läker sig själv efter inloggnings-reset, skärm-hotplug eller strömblink.
MAP_TOUCH_WATCH=5

# Vänta N sek innan första mappningen (så X/skärmarna hunnit upp vid autostart).
MAP_TOUCH_DELAY=3
