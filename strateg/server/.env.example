# Kopiera till server/.env (gitignore:ad) och fyll i din nyckel.
# .env committas ALDRIG. Byte av nyckel (Josefs → driftens) = ändra HÄR, ingen kodändring.

# OpenAI-nyckel för /chat. Utan nyckel svarar backend med MOCK-svar (UI går ändå att demo:a).
AI_API_KEY=sk-...

# Valfritt: modell (default gpt-5-mini — samma familj som minnestest-stationen).
# STRATEG_MODEL=gpt-5-mini

# Valfritt: port (default 8790; spelservern kör på 8765 så de krockar inte).
# PORT=8790
