# Konfig för rigg-driften på huvud-NUC:en. Verifiera sink-namnen med:
#   pactl list short sinks
# (de kan ändras om du byter USB-port eller skärm — kolla på plats.)

# Rigg-ljudets utgång = hjärnans ljud (award, soundscape, GM) → Anker-högtalaren
AUDIO_SINK="alsa_output.usb-ANKER_Anker_PowerConf_S330_ACCUDP1F07200725-00.analog-stereo"

# Standard-utgång = spelets klick i webbläsaren → skärmen (HDMI)
SCREEN_SINK="alsa_output.pci-0000_00_1f.3.hdmi-stereo"

# Broker som spelservern publicerar rigg-cues till (localhost = allt på denna NUC)
RIGG_BROKER="localhost"
